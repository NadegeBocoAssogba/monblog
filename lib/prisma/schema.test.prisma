datasource db {
  provider = "sqlite"
  url      = "file:./test.db" // Un fichier local qui sera créé uniquement pour les tests
}

generator client {
  provider = "prisma-client-client"
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  published Boolean  @default(false)
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
}
